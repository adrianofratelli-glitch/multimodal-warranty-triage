# MongoDB Atlas — nunca commitar o .env real
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=analise_garantia
MONGODB_COLLECTION=chamados
MONGODB_CATALOGO_COLLECTION=catalogo
MONGODB_PEDIDOS_COLLECTION=pedidos
MONGODB_CATALOGO_FOTOS_COLLECTION=catalogo_fotos
VECTOR_INDEX_NAME=defeitos_vector_index
TEXT_INDEX_NAME=chamados_text_index
CATALOGO_FOTOS_VECTOR_INDEX_NAME=catalogo_fotos_vector_index

# Claude (visão, tool use forçado) SEMPRE via gateway Grove (_shared/grove_client):
# Authorization: Bearer + a chave real em x-api-key. Sem fallback para a API direta.
GROVE_BASE_URL=https://<gateway-host>/anthropic
GROVE_API_KEY=<grove-api-key>
# GROVE_API_KEY_SECONDARY=<grove-api-key-secundaria>
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
# Resiliência ligada por padrão (estes só ajustam/desligam):
# GROVE_TIMEOUT_SECONDS=30  GROVE_RETRIES=2  GROVE_CB_THRESHOLD=5  GROVE_MODEL_FALLBACKS=
# LLM_DEADLINE_SECONDS=90   # prazo total do veredito; estourou -> revisão manual

# Langfuse (opcional, fail-open: sem chave vira no-op)
# LANGFUSE_PUBLIC_KEY=<pk>
# LANGFUSE_SECRET_KEY=<sk>
# LANGFUSE_HOST=https://<langfuse-host>

# Voyage AI (embedding multimodal manual)
VOYAGE_API_KEY=<voyage-api-key>
EMBEDDING_MODEL=voyage-multimodal-3.5
EMBEDDING_DIMENSIONS=1024
# VOYAGE_TIMEOUT_SECONDS=30  VOYAGE_MAX_RETRIES=3 (tentativas totais)  EMBED_DEADLINE_SECONDS=60

# Scripts que escrevem dado (seed*, setup_indexes, scripts/reset_demo.py) só rodam
# livres em banco *_test; no banco da demo exigem ALLOW_DEMO_DB_WRITE=1.

# Imagens — storage LOCAL no PoV (em prod, trocar storage.py por S3 + CDN)
# MEDIA_ROOT=./media          # padrão: backend/media
# MAX_IMAGE_BYTES=10485760     # 10 MB

# Fotos de seed — o repo NAO vem com fotos de exemplo. Aponte para uma pasta
# própria com fotos do seu catálogo (mesma estrutura esperada por seed.py/
# seed_catalogo_fotos.py — ver README). Sem fotos reais ainda? Gere placeholders
# sintéticos com generate_placeholders.py / generate_catalogo_placeholders.py.
# SEED_IMAGES_DIR=/caminho/para/suas/fotos   # padrão: ../seed_images (relativo a backend/)
